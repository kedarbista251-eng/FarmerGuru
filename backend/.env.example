# Set these values in Render's Environment page. Do not commit a real .env file.
GEMINI_API_KEY=your_google_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

# Render PostgreSQL supplies this as an internal DATABASE_URL.
DATABASE_URL=postgresql://username:password@host:5432/database_name

# Generate a long, random secret for production (for example: openssl rand -hex 32).
JWT_SECRET=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional: configure these three values to send real password reset SMS messages.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# The public frontend origin. For more than one, separate URLs with commas.
FRONTEND_URL=https://your-frontend.onrender.com
